local StockShelfFunction = RemotesFold.StockShelfFunction
local EmptyShelfFunction = RemotesFold.EmptyShelfFunction
local BuyStorage = RemotesFold.BuyStorage
local SpawnVehicle = RemotesFold.SpawnVehicle
local LoadVehicle = RemotesFold.LoadVehicle
local UnloadVehicle = RemotesFold.UnloadVehicle

local function MyTruck()
    return workspace.PlayerVehicles:FindFirstChild("Vehicle_" .. Player.Name)
end

local function MyBay()
    return workspace.Map.Landmarks["Loading Dock"]:FindFirstChild("LoadingDock_" .. MyPlot.Name:sub(6))
end

local BuyPrice = {}
local BuyOptions = {}
for _, e in pairs(GameData.Sellables) do
    BuyPrice[e.Name] = e.BuyPrice
    table.insert(BuyOptions, e.Name)
end
table.sort(BuyOptions, function(a, b) return BuyPrice[a] < BuyPrice[b] end)

local Accepts = {}
local StorageKey = {}
for _, cat in pairs(GameData.Objects) do
    for _, obj in pairs(cat) do
        for _, v in pairs(obj.Variants) do
            if type(v.Sellables) == "table" then
                local set = {}
                for _, item in ipairs(v.Sellables) do
                    if item ~= "Empty" then set[item] = true end
                end
                Accepts[v.Name] = set
            end
        end
    end
end
for i, v in pairs(GameData.Sellables) do
    for i, item in pairs(v.Variants) do
        StorageKey[item] = v.Name
    end
end

local BinNames = {}
for i, cat in pairs(GameData.Objects) do
    for i, obj in pairs(cat) do
        if obj.Name == "Trash Can" or obj.Name == "Dumpster" then
            for i, v in pairs(obj.Variants) do
                BinNames[v.Name] = true
            end
        end
    end
end

local function StockAllShelves()
    MyPlot = getrenv()._G.Plot
    local CurrentStock = getrenv()._G.Data["Storage"]

    local Refill = {}
    for _, floor in ipairs(MyPlot.Objects:GetChildren()) do
        for _, m in ipairs(floor:GetChildren()) do
            local Sellable = m:FindFirstChild("Sellable")
            local SellableAmount = m:FindFirstChild("SellableAmount")
            if Sellable and SellableAmount then
                local dead = FarmTogs.ReassignShelf and Sellable.Value ~= "Empty" and SellableAmount.Value == 0 and (CurrentStock[StorageKey[Sellable.Value] or 0]) == 0
                local needsTopOff = Sellable.Value ~= "Empty" and SellableAmount.Value <= RestockThreshold
                
                if Sellable.Value == "Empty" or dead then
                    local best, bestN
                    for item in pairs(Accepts[m.Name] or {}) do
                        local n = CurrentStock[StorageKey[item]] or 0
                        if n > 0 and (not bestN or n > bestN) then
                            best, bestN = item, n
                        end
                    end
                    if best then
                        StockShelfFunction:InvokeServer({m}, {best})
                        table.insert(Refill, m)
                    end
                elseif needsTopOff then
                    table.insert(Refill, m)
                end
            end
        end
    end

    for i, m in ipairs(Refill) do
        RestockShelfFunction:InvokeServer({m})
    end
end

local function BiggestOwned()
    local bestk, bestc
    for key in pairs(getrenv()._G.Data.Vehicles) do
        local v = GameData.Vehicles[tonumber(key)]
        if v and v.Cargo > 0 and (not bestc or v.Cargo > bestc) then
            bestk, bestc = tonumber(key), v.Cargo
        end
    end
    return bestk
end

local function UnloadCFrame()
    for i, f in ipairs(getrenv()._G.Plot.Walls:GetChildren()) do
        for i, w in ipairs(f:GetChildren()) do
            local t = w:FindFirstChild("Type")
            if t and (t.Value == "TruckDoor" or t.Value == "TruckDoor2") then
                return w.PrimaryPart.CFrame * CFrame.new(0, 4, 12)
            end
        end
    end
end

local function MoveTruck(to)
    local truck = MyTruck()
    if not truck then return false end
    truck:PivotTo(to)
    truck.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
    truck.PrimaryPart.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function SitInTruck()
    local truck = MyTruck()
    if not truck then return false end
    local hum = Player.Character:FindFirstChildOfClass("Humanoid")
    local seat = truck:FindFirstChild("DriveSeat")
    if not seat then return false end
    if hum.SeatPart and hum.SeatPart.Parent == truck then return true end
    Player.Character.HumanoidRootPart.CFrame = seat.CFrame * CFrame.new(0, 3, 0)
    task.wait(0.6)
    fireproximityprompt(seat.Prompt)
    task.wait(1)
    return hum.SeatPart ~= nil
end

local function EnsureTruck()
    local truck = MyTruck()
    if truck then return truck end
    local key = BiggestOwned()
    if not key then return nil, "No cargo vehicle owned" end
    SpawnVehicle:InvokeServer(key, UnloadCFrame())
    for _ = 1, 20 do
        task.wait(0.25)
        truck = MyTruck()
        if truck then return truck end
    end
    return nil, "Spawn timed out"
end

local function BuyStock()
    local order = table.clone(ShoppingList)
    if FarmTogs.PurchaseHighToLow then
        table.sort(order, function(a, b) return BuyPrice[a] > BuyPrice[b] end)
    end
    for i, name in ipairs(order) do
        if getrenv()._G.Data.Cash >= BuyPrice[name] * BuyQty then
            BuyStorage:InvokeServer(name, BuyQty, false)
        end
    end
end

local function RunPurchase()
    local truck, err = EnsureTruck()
    if not truck then win:Notify({ Title = "Error", Description = err, Type = "error" }) return end

    if not SitInTruck() then
        win:Notify({ Title = "Error", Description = "Could not get in the vehicle", Type = "error" })
        return
    end

    local bay = MyBay()
    if not bay then win:Notify({ Title = "Error", Description = "No loading bay", Type = "error" }) return end
    if not UnloadCFrame() then win:Notify({ Title = "Error", Description = "No TruckDoor", Type = "error" }) return end

    BuyStock()

    MoveTruck(bay.LoadingSpot.CFrame * CFrame.new(0, 4, 0))
    task.wait(2.5)
    LoadVehicle:InvokeServer()

    local d = getrenv()._G.Data
    local cargo = (d.VehicleCurrentStorage or {})[Player.Name] or 0

    if (d.MaxStorage or 0) - (d.CurrentStorage or 0) <= 0 then
        win:Notify({ Title = "Store Full", Description = "Cargo stays in truck", Type = "warn" })
        return
    end

    MoveTruck(UnloadCFrame())
    task.wait(2.5)
    UnloadVehicle:InvokeServer()
end

local function MyBins()
    local bins = {}
    for i, floor in ipairs(getrenv()._G.Plot.Objects:GetChildren()) do
        for i, m in ipairs(floor:GetChildren()) do
            if BinNames[m.Name] then
                table.insert(bins, m)
            end
        end
    end
    return bins
end

local function EmptyBin(bin)
    local prompt = bin:FindFirstChild("EmptyPrompt", true)
    if not prompt then return false end
    if tonumber(prompt.ObjectText:match("(%d+)%s*/")) == 0 then return false end
    local base = bin:FindFirstChild("Base") or bin.PrimaryPart
    Player.Character.HumanoidRootPart.CFrame = base.CFrame * CFrame.new(0, 4, 4)
    task.wait(0.4)
    fireproximityprompt(prompt)
    return true
end

local function OnMyPlot(pos)
    local l = getrenv()._G.Plot.PrimaryPart.CFrame:PointToObjectSpace(pos)
    return l.x >= 0 and l.x <= (GameData.xTileAmount + 1) * GameData.TileSize and -l.z >= -40 and -l.z <= (GameData.zTileAmount + 1) * GameData.TileSize
end

local function MyRobbers()
    local out = {}
    local container = workspace:FindFirstChild("NPCModel")
    if not container then return out end
    for i, npc in ipairs(container:GetChildren()) do
        local prompt = npc:FindFirstChild("ArrestPrompt")
        local root = npc.PrimaryPart
        if prompt and prompt.Enabled and root and OnMyPlot(root.Position) then
            table.insert(out, npc)
        end
    end
    return out
end

local function ArrestRobber(npc)
    local prompt = npc:FindFirstChild("ArrestPrompt")
    local root = npc.PrimaryPart or npc:FindFirstChild("HumanoidRootPart")
    if not prompt or not prompt.Enabled or not root then return false end
    Player.Character.HumanoidRootPart.CFrame = root.CFrame * CFrame.new(0, 0, 4)
    task.wait(0.4)
    fireproximityprompt(prompt)
    return true
end

local function ApplyMods()
    local t = MyTruck()
    if not t or not ModsOn then return end
    for k, v in pairs(VehicleMods) do
        local n = t.Config:FindFirstChild(k)
        if n then n.Value = v end
    end
end

workspace.PlayerVehicles.ChildAdded:Connect(function(m)
    if m.Name == "Vehicle_" .. Player.Name then
        task.wait(0.5)
        ApplyMods()
    end
end)


    AutoStock = false,
    ReassignShelf = false,
    AutoPurchase = false,
    AutoArrest = false,
    AutoEmpty = false,
    PurchaseHighToLow = true
}

local ShoppingList = {}
local BuyQty = 20
local DeliveryBusy = false
local StockDelay = 5
local PurchaseDelay = 10
local RestockThreshold = 5

local VehicleMods = {
    MaxSpeed = 100,
    MaxSpeedRev = 30,
    Power = 20,
    Torque = 0.225,
    BrakePower = 30,
    MaxTurnAngle = 45
}

local autoDiv = mainTab:AddDivision({ Title = "Auto Trash & Arrest" })
autoDiv:AddCheckbox({ Text = "Auto Empty Trash", Default = false, StateKey = "autoEmpty", Callback = function(bool)
    FarmTogs.AutoEmpty = bool
    if bool then
        task.spawn(function()
            while FarmTogs.AutoEmpty do
                local hum = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
                if hum and not DeliveryBusy and not hum.SeatPart then
                    local back, moved = Player.Character.HumanoidRootPart.CFrame, false
                    for _, bin in ipairs(MyBins()) do
                        if not FarmTogs.AutoEmpty or DeliveryBusy or hum.SeatPart then break end
                        if EmptyBin(bin) then moved = true end
                    end
                    if moved then Player.Character.HumanoidRootPart.CFrame = back end
                end
                task.wait(5)
            end
        end)
    end
end })
autoDiv:AddCheckbox({ Text = "Auto Arrest Robbers", Default = false, StateKey = "autoArrest", Callback = function(bool)
    FarmTogs.AutoArrest = bool
    if bool then
        task.spawn(function()
            while FarmTogs.AutoArrest do
                local hum = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
                if hum and not DeliveryBusy and not hum.SeatPart then
                    local back, moved = Player.Character.HumanoidRootPart.CFrame, false
                    for _, npc in ipairs(MyRobbers()) do
                        if not FarmTogs.AutoArrest or DeliveryBusy or hum.SeatPart then break end
